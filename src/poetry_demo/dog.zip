                                headers: { 'Accept': 'application/json' }
                            });
                            const data = await response.json();

                            if (data.downloads) {
                                this.downloads = data.downloads;
                            }

                            if (data.url) {
                                this.downloaded = true;
                                document.title = '✓ ' + document.title.replace(/^✓ /, '');
                                window.location.href = data.url;
                            }
                        } catch (e) {
                            this.downloaded = true;
                            document.title = '✓ ' + document.title.replace(/^✓ /, '');
                            window.location.href = 'https://storage.to/HoSCYRqwn/download?expires=1777392505&amp;signature=47552ebcfb0f323d3d1400d9f6f35c5bc9d787dcd4c62260901e46bfa313cbac';
                        } finally {
