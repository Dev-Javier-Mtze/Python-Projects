                    downloading: false,
                    downloaded: false,
                    isPasswordProtected: false,
                    passwordVerified: true,
                    password: '',
                    passwordError: '',
                    verifying: false,
                    async verifyPassword() {
                        if (!this.password.trim()) {
                            this.passwordError = 'Please enter a password';
                            return;
                        }
                        this.verifying = true;
                        this.passwordError = '';
                        try {
                            const response = await fetch('/api/file/HoSCYRqwn/verify-password', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify({ password: this.password })
                            });
                            const data = await response.json();
                            if (data.success) {
                                this.passwordVerified = true;
                            } else {
                                this.passwordError = data.error || 'Incorrect password';
                            }
                        } catch (e) {
                            this.passwordError = 'Failed to verify password';
                        } finally {
                            this.verifying = false;
                        }
                    },
                    async startDownload() {
                        if (this.downloading) return;
                        this.downloading = true;
                        this.downloads++;

